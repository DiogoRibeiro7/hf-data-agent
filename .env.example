# ---- Model (swap GPT-5.2 for an open HF model) ----
# mock (default, no deps) | transformers | openai_compatible | hf_inference
DA_MODEL_BACKEND=mock
DA_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
DA_MODEL_MAX_NEW_TOKENS=512
DA_MODEL_TEMPERATURE=0.2
# openai_compatible (vLLM/TGI):
DA_MODEL_BASE_URL=http://localhost:8001/v1
DA_MODEL_API_KEY=not-needed
# hf_inference:
DA_HF_TOKEN=

# ---- Knowledge base / RAG ----
DA_EMBEDDER_BACKEND=hashing        # hashing (no deps) | sentence_transformers
DA_EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2
DA_VECTOR_STORE_PATH=data/vector_store.json
DA_RETRIEVAL_TOP_K=4

# ---- Data platform ----
# Use a database user with SELECT and nothing else: the SQL guard is a safety
# net, the grant is the security boundary. See SECURITY.md.
DA_WAREHOUSE_DSN=sqlite:///data/warehouse.db
# Rows returned per warehouse query before the result is truncated.
DA_WAREHOUSE_MAX_ROWS=1000
# Optional comma-separated allow-list; empty means every table is queryable.
DA_WAREHOUSE_ALLOWED_TABLES=
DA_AIRFLOW_BASE_URL=http://localhost:8080

# ---- Logging ----
DA_LOG_LEVEL=INFO
DA_LOG_FORMAT=text                 # text (human-readable) | json (for shipping)

# ---- API ----
DA_API_HOST=0.0.0.0
DA_API_PORT=8000

# ---- Slack ----
DA_SLACK_BOT_TOKEN=
DA_SLACK_SIGNING_SECRET=
