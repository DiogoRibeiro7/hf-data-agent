# ---- Model (swap GPT-5.2 for an open HF model) ----
# mock (default, no deps) | transformers | openai_compatible | hf_inference
DA_MODEL_BACKEND=mock
DA_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
DA_MODEL_MAX_NEW_TOKENS=512
DA_MODEL_TEMPERATURE=0.2
# openai_compatible (vLLM/TGI):
DA_MODEL_BASE_URL=http://localhost:8001/v1
DA_MODEL_API_KEY=not-needed
# hf_inference:
DA_HF_TOKEN=

# ---- Knowledge base / RAG ----
DA_EMBEDDER_BACKEND=hashing        # hashing (no deps) | sentence_transformers
DA_EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2
DA_VECTOR_STORE_PATH=data/vector_store.json
DA_RETRIEVAL_TOP_K=4

# ---- Tool-calling loop ----
DA_ENABLE_TOOLS=true               # false = original single-shot RAG behaviour
DA_MAX_TOOL_STEPS=4                # tool executions per question before a final answer
DA_TOOL_RESULT_MAX_CHARS=4000      # observations longer than this are truncated

# ---- SaaS knowledge connectors (offline ingestion; opt in per run) ----
# None of these has been verified against its live API — check the document
# count reported by scripts/ingest.py on the first real run.
# Notion: an integration token, and the databases it has been shared with.
DA_NOTION_TOKEN=
DA_NOTION_DATABASE_IDS=
# Slack ingestion: needs channels:history (groups:history for private channels).
DA_SLACK_INGEST_TOKEN=
DA_SLACK_INGEST_CHANNELS=
# Google Docs: needs pip install ".[gdocs]". The folder must be SHARED with the
# service account's email, or it authenticates fine and finds nothing.
DA_GDOCS_CREDENTIALS=
DA_GDOCS_FOLDER_ID=
DA_GDOCS_RECURSIVE=false

# ---- Data platform ----
# Use a database user with SELECT and nothing else: the SQL guard is a safety
# net, the grant is the security boundary. See SECURITY.md.
DA_WAREHOUSE_DSN=sqlite:///data/warehouse.db
# Rows returned per warehouse query before the result is truncated.
DA_WAREHOUSE_MAX_ROWS=1000
# Optional comma-separated allow-list; empty means every table is queryable.
DA_WAREHOUSE_ALLOWED_TABLES=
DA_AIRFLOW_BASE_URL=http://localhost:8080

# ---- Logging ----
DA_LOG_LEVEL=INFO
DA_LOG_FORMAT=text                 # text (human-readable) | json (for shipping)

# ---- API ----
# Loopback by default. Binding anything routable requires DA_API_TOKEN, or
# DA_ALLOW_UNAUTHENTICATED=true if the port is protected some other way.
DA_API_HOST=127.0.0.1
DA_API_PORT=8000
# Bearer token required by /ask and /tool. Empty = no authentication.
DA_API_TOKEN=
DA_ALLOW_UNAUTHENTICATED=false

# ---- Remote MCP ----
# Guarded by DA_API_TOKEN as well, via an ASGI gate in front of the transport.
DA_MCP_HOST=127.0.0.1
DA_MCP_PORT=8001

# ---- Slack ----
DA_SLACK_BOT_TOKEN=
DA_SLACK_SIGNING_SECRET=
