# Normalise to LF in the repository; check out native on Windows.
* text=auto

# Always LF — these are executed by shells and containers.
*.sh          text eol=lf
Makefile      text eol=lf
Dockerfile    text eol=lf
*.py          text eol=lf
*.toml        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# Never touch binaries.
*.png binary
*.jpg binary
*.ico binary
*.db  binary

# Keep generated/vendored files out of diffs and language stats.
data/vector_store.json linguist-generated=true
